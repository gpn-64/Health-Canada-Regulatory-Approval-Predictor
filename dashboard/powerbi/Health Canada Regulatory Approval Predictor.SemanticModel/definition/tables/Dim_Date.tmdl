table Dim_Date
	lineageTag: b9b2e2ab-6c97-4194-81bb-e98d863c6ec9
	dataCategory: Time

	column Date
		formatString: yyyy-mm-dd
		lineageTag: 2820a2a5-ef06-4345-a957-197f51d326bb
		dataCategory: PaddedDateTableDates
		isNameInferred
		sourceColumn: [Date]

	column Année
		lineageTag: 8da06397-fc17-47f5-91a4-97dfc3c0ea62
		sourceColumn: [Année]

	column 'N° mois'
		lineageTag: a8d2ff08-4baa-4a0b-b855-595066041391
		sourceColumn: [N° mois]

	column Mois
		lineageTag: 64dc8dad-f941-41bd-a1ba-3cd70abf89b7
		sourceColumn: [Mois]
		sortByColumn: 'N° mois'

	column Année-Mois
		lineageTag: 61eedef0-5cb7-4cf5-9d53-48605521580a
		sourceColumn: [Année-Mois]

	column Trimestre
		lineageTag: 28c251f2-f1af-47ab-bae8-94b111e0ffb0
		sourceColumn: [Trimestre]

	column 'Début de mois'
		lineageTag: 31127b9b-fc1e-476b-aeb2-53d05c7b8fbe
		sourceColumn: [Début de mois]

	partition Dim_Date = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE(2015,1,1), DATE(2027,12,31) ), "Année", YEAR([Date]), "N° mois", MONTH([Date]), "Mois", FORMAT([Date],"MMM"), "Année-Mois", FORMAT([Date],"YYYY-MM"), "Trimestre", "T" & FORMAT([Date],"Q"), "Début de mois", DATE(YEAR([Date]),MONTH([Date]),1) )

