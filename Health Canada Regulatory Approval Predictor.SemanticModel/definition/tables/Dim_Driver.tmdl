	partition Dim_Driver = m
		mode: import
		source = let S0 = Csv.Document(File.Contents("C:\Users\User\Documents\Coding Projects\Health-Canada-Regulatory-Approval-Predictor\reports\feature_effects.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]), P = Table.PromoteHeaders(S0,[PromoteAllScalars=true]), T = Table.TransformColumnTypes(P,{{"flag",type text},{"n_with",Int64.Type},{"median_review_days_with",type number},{"median_review_days_without",type number},{"approval_rate_with",type number},{"approval_rate_without",type number}}) in T

