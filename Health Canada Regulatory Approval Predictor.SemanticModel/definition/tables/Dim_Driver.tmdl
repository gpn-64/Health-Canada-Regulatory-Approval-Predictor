	column flag_label = SWITCH ( Dim_Driver[flag], "priority_review", "Examen prioritaire", "biosimilar", "Biosimilaire", "noc_c", "AC-C (NOC/c)", "project_orbis_a", "Projet Orbis A", "project_orbis_b", "Projet Orbis B", "project_orbis_c", "Projet Orbis C", "access_consortium", "Consortium Access (ACSS)", "hta_aligned", "Aligné ACMTS/INESSS", "covid19", "COVID-19", "is_supplemental", "Supplément (SNDS)", "new_active_substance", "Nouvelle substance active", "third_party_data", "Données de tiers", "extraordinary_use", "Usage exceptionnel", Dim_Driver[flag] )
